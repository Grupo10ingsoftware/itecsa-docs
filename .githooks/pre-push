#!/bin/sh

set -eu

stdin_file="${TMPDIR:-/tmp}/itecsa-pre-push-$$.stdin"
trap 'rm -f "$stdin_file"' EXIT HUP INT TERM
cat > "$stdin_file"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    printf >&2 "\npre-push: push directo a main bloqueado.\n"
    printf >&2 "Crea una rama de trabajo, por ejemplo: git switch -c docs/nombre-del-cambio\n"
    printf >&2 "Luego sube esa rama y abre una Pull Request hacia main.\n\n"
    exit 1
  fi
done < "$stdin_file"

command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs pre-push "$@" < "$stdin_file"
