        <mxCell id="note_vista_general_4" value="Pendiente: catalogo final de estados documentales. Los archivos conservan metadatos y referencia, no binarios." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="1">
