        <mxCell id="note_supuestos" value="&lt;b&gt;Supuestos&lt;/b&gt;&lt;br&gt;- Las relaciones punteadas tienen cardinalidad pendiente de validar.&lt;br&gt;- Pedido y Nota de Venta se muestran como 1 a 1, pendiente de validar con datos reales.&lt;br&gt;- Pedido puede tener 0..N Orden de Produccion por la expresion la o las ordenes.&lt;br&gt;- Pedido puede tener 0..1 Ficha de cliente, pendiente de validar.&lt;br&gt;- Pedido y Capacidad se muestran como 0..N a 0..1 para representar consumo o validacion de capacidad.&lt;br&gt;- Llaves primarias no cerradas se muestran como identificadores conceptuales o pendientes." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=20;align=left;verticalAlign=top;spacing=8;fillColor=#fff7ed;strokeColor=#c2410c;fontColor=#111827;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3380" y="2940" width="850" height="195" as="geometry" />
        </mxCell>
        <mxCell id="note_valores" value="&lt;b&gt;Valores controlados&lt;/b&gt;&lt;br&gt;- Tipo de producto: Lanyard, Tarjeta. No se modela como entidad.&lt;br&gt;- Estado de pago: Confirmado, Rechazado, Pendiente.&lt;br&gt;- Estado Kanban: Confirmacion de pago, Listo para produccion, En produccion, Listo para entrega.&lt;br&gt;- Etiquetas: Urgencia, Atraso.&lt;br&gt;- Canales: Aplicacion, correo electronico, panel interno.&lt;br&gt;- Subprocesos Lanyard: Impresion, sublimacion, corte, costura.&lt;br&gt;- Subprocesos Tarjeta: Revisar informacion, Ordenar informacion, Cargar datos." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=20;align=left;verticalAlign=top;spacing=8;fillColor=#fefce8;strokeColor=#a16207;fontColor=#111827;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3380" y="3200" width="900" height="240" as="geometry" />
        </mxCell>
